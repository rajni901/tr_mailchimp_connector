<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cron_mc_sync_audiences" model="ir.cron">
        <field name="name">MailChimp: Sync Audiences</field>
        <field name="model_id" ref="model_mailchimp_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_audiences()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active">False</field>
    </record>

    <record id="cron_mc_sync_contacts" model="ir.cron">
        <field name="name">MailChimp: Sync Contacts</field>
        <field name="model_id" ref="model_mailchimp_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_contacts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">False</field>
    </record>

    <record id="cron_mc_import_stats" model="ir.cron">
        <field name="name">MailChimp: Import Campaign Statistics</field>
        <field name="model_id" ref="model_mailchimp_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_import_stats()</field>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
        <field name="active">False</field>
    </record>

</odoo>
