<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mailchimp_log_list" model="ir.ui.view">
        <field name="name">mailchimp.log.list</field>
        <field name="model">mailchimp.log</field>
        <field name="arch" type="xml">
            <list string="MailChimp Sync Logs"
                  decoration-danger="status == 'error'"
                  decoration-success="status == 'success'"
                  decoration-warning="status == 'warning'">
                <field name="create_date"/>
                <field name="account_id"/>
                <field name="operation"/>
                <field name="status"/>
                <field name="mc_id"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_mailchimp_log_search" model="ir.ui.view">
        <field name="name">mailchimp.log.search</field>
        <field name="model">mailchimp.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="operation"/>
                <field name="account_id"/>
                <filter name="errors" string="Errors" domain="[('status','=','error')]"/>
                <filter name="success" string="Success" domain="[('status','=','success')]"/>
                <separator/>
                <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="action_mailchimp_logs" model="ir.actions.act_window">
        <field name="name">MailChimp Sync Logs</field>
        <field name="res_model">mailchimp.log</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
